PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_gateway

# Control-plane authentication. Generate a long random value.
ADMIN_TOKEN=replace-with-a-long-random-token

# Used to encrypt upstream provider keys at rest.
MODEL_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
